APP_NAME=NoxLock
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://emi.chatvoo.com

# NoxLock Configuration
NOXLOCK_APK_VERSION=1.0.0
NOXLOCK_DEFAULT_DEVICE_STATUS=active
NOXLOCK_AUTO_LOCK_HOURS=24
NOXLOCK_HEARTBEAT_TIMEOUT=10

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=noxlock
# DB_USERNAME=root
# DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@emi.chatvoo.com
MAIL_FROM_NAME="${APP_NAME}"

# Firebase FCM V1
FIREBASE_PROJECT_ID=emil-9d8f6
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

# GitHub Auto-Deploy Webhook Secret
DEPLOY_WEBHOOK_SECRET=your_random_secret_here
